{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Text to Write",
  "version": "1.2.0",
  "identifier": "com.minkr.texttowrite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Text to Write",
        "width": 360,
        "height": 760,
        "minWidth": 320,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
